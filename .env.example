# RPC endpoints
# Used by forge test --fork-url and forge script --rpc-url
BASE_MAINNET_RPC=
BASE_SEPOLIA_RPC=

# 01_Deploy.s.sol
# Address of the EOA/keystore that signs and pays for deployment
DEPLOYER_ADDRESS=
# Address whose ECDSA signature authorises paymaster sponsorship (hot signer)
VERIFYING_SIGNER_ADDRESS=
# Address that will own the paymaster after deployment (defaults to DEPLOYER_ADDRESS if unset)
PAYMASTER_OWNER_ADDRESS=

# 02_FundPaymaster.s.sol
# Address of the deployed MozaikVerifyingPaymaster contract
PAYMASTER_ADDRESS=
# How much ETH to deposit into the EntryPoint on behalf of the paymaster, in wei
# Example: 100000000000000000 = 0.1 ETH
DEPOSIT_AMOUNT_WEI=

# 03_TransferOwnership.s.sol
# Address of the multisig that will become the new paymaster owner
# Ownership is two-step (Ownable2Step): the multisig must call acceptOwnership() to complete
MULTISIG_ADDRESS=
