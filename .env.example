# RPC endpoints
# Used by forge test --fork-url and forge script --rpc-url
BASE_MAINNET_RPC=
BASE_SEPOLIA_RPC=
# Ethereum L1, used only by 04_DeployMozaikL1Resolver.s.sol (ENS lives on L1)
ETH_MAINNET_RPC=
ETH_SEPOLIA_RPC=

# 01_Deploy.s.sol
# Address whose ECDSA signature authorises paymaster sponsorship (hot wallet)
SPONSOR_ADDRESS=
# Optional: override the paylinks USDC token. Defaults to the canonical USDC for
# the target chain (Base mainnet/sepolia) when unset.
# USDC_ADDRESS=

# 02_FundPaymaster.s.sol
# Address of the deployed MozaikVerifyingPaymaster contract
PAYMASTER_ADDRESS=
# How much ETH to deposit into the EntryPoint on behalf of the paymaster, in wei
# Example: 100000000000000000 = 0.1 ETH
DEPOSIT_AMOUNT_WEI=

# 03_TransferOwnership.s.sol
# Address that will become the new paymaster owner
# Ownership is two-step (Ownable2Step): the new owner must call acceptOwnership() to complete
NEW_OWNER_ADDRESS=

# 04_DeployMozaikL1Resolver.s.sol
# EIP-3668 URL template the resolver hands to wallets, for example https://ens.mozaik.money/ccip/{sender}/{data}.json
ENS_GATEWAY_URL=
# Comma-separated addresses whose signatures the resolver accepts (the gateway signer)
ENS_SIGNER_ADDRESSES=
# Owner of the resolver. It can change the URL, the signers, and the root resolver
ENS_RESOLVER_OWNER=
# Resolver that holds the parent name's own records (the ENS public resolver the name uses today)
ENS_ROOT_RESOLVER=
# Parent name whose subnames the gateway serves, dotted form (for example mozaikpay.eth)
ENS_PARENT_NAME=

# VerifyDeploy.s.sol
# Address of the deployed MozaikAccountFactory contract
FACTORY_ADDRESS=
# Address of the deployed MozaikPaylinks escrow (deployed by 01_Deploy)
PAYLINKS_ADDRESS=

# Contract verification (Basescan). A single Etherscan V2 API key covers both
# Base mainnet (8453) and Base Sepolia (84532). Get one at etherscan.io.
ETHERSCAN_API_KEY=
